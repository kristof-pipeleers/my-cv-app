{
  "name": "my-cv-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://kristofpipeleers.be",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "build:dev": "tsc --noEmit && vite build --mode dev --base=/dev/ && node scripts/prerender.mjs --mode dev --base /dev/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pdf": "node scripts/generate-pdf.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
